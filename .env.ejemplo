# =============================================================================
#  Taller 4 · «Entidades seguras en un mundo digital»
#  Variables de entorno del despliegue. Copia este fichero a «.env» y ajusta
#  los valores. NO subas el fichero .env a un repositorio: contiene la
#  contraseña del panel de dinamización.
#
#      cp .env.ejemplo .env
#      chmod 600 .env
# =============================================================================

# ---------------------------------------------------------------------------
# Panel de dinamización (obligatorio en producción)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=cambia-esta-contraseña-por-una-larga-y-unica

# ---------------------------------------------------------------------------
# Fecha del taller: marca el inicio del plazo de conservación de datos.
# ---------------------------------------------------------------------------
WORKSHOP_DATE=2026-11-22
RETENTION_DAYS=10
MIN_N=3

# ---------------------------------------------------------------------------
# Dirección pública de la app. Es la que codifica el QR del cartel.
# Debe incluir https:// y ser exactamente la URL por la que entran las
# personas participantes (por ejemplo, https://taller4.perezllorca.com).
# ---------------------------------------------------------------------------
PUBLIC_URL=https://taller4.example.org

# ---------------------------------------------------------------------------
# Información del responsable del tratamiento (art. 13 RGPD).
# Rellena estos datos con los reales antes del taller: aparecen en la
# pantalla de inicio y en la página /legal.
# ---------------------------------------------------------------------------
RESPONSABLE=Pérez-Llorca
RESPONSABLE_CARGO=Responsable del tratamiento de los datos del taller
CONTACTO=protecciondatos@perezllorca.com

# Proveedor de alojamiento: es un encargado (art. 28 RGPD). Pon aquí el nombre
# real de quien hospeda el servidor.
ENTIDAD_ALOJAMIENTO=Nombre del proveedor de alojamiento (encargado, art. 28 RGPD)

# Destinatario externo de los resultados agregados.
DESTINATARIO_EXTERNO=Fundación Fresno

# Base jurídica que se declara en la información legal.
BASE_LEGAL=Participación voluntaria en el taller: consentimiento (art. 6.1.a RGPD). Los resultados agregados no son datos personales (Directrices 01/2025 del CEPD).

# Enlace a la información completa sobre el tratamiento (por ejemplo, la
# política de privacidad de Pérez-Llorca).
ENLACE_INFO=

# ---------------------------------------------------------------------------
# Datos del evento para la cabecera de la app.
# ---------------------------------------------------------------------------
FECHA_TEXTO=Encuentro anual de la Red Solidaria Santander
LUGAR_TEXTO=
